# Get a key at https://ai.google.dev/gemini-api/docs/api-key
# (used by the ADK assistant in main.py)
GEMINI_API_KEY=your_api_key_here

# Get a key at https://platform.openai.com/api-keys
# (used by the LangGraph research assistant: uv run research)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: model for the research assistant (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
